# Copy existing .env during migration; do not regenerate existing keys.
HOMEBOX_MCP_TAG=latest
HOMEBOX_URL=http://homebox:7745
HOMEBOX_PUBLIC_URL=https://inventory.example.invalid
HOMEBOX_TOKEN=

# Proposed new subdomain. Configure it in DNS and Pangolin first.
MCP_PUBLIC_URL=https://mcp.example.invalid
MCP_BIND_IP=127.0.0.1
MCP_PORT=18080

# github = GitHub OAuth; oidc = existing Pocket ID / Authentik / other OIDC
AUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# GitHub: numeric account ID. OIDC: exact sub claim. Comma-separated.
# Do not enter your email or GitHub username here.
OAUTH_ALLOWED_SUBJECTS=

# Generated locally by prepare.py. Do not send secrets to chat.
OAUTH_SIGNING_KEY=
PANGOLIN_ORIGIN_SECRET=

# Only used with AUTH_PROVIDER=oidc:
OIDC_CONFIG_URL=
OIDC_SCOPES=openid profile
OIDC_TOKEN_AUTH_METHOD=client_secret_basic

# Optional: expose reviewed Ferret MCP inventory tools through the same OAuth gateway.
# Both URL and key must be set to enable. Use the RAW key, without "Bearer ".
# Keep the real URL/token only in the NAS/Dockge .env; never commit either.
FERRET_MCP_URL=
FERRET_MCP_TOKEN=
# Read-only by default. Opt in to specific reviewed write tools if needed.
# Example: FERRET_WRITE_TOOLS=create_item,update_item
FERRET_WRITE_TOOLS=
